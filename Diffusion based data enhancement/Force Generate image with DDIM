,consolas,'Courier New',monospace\"><span style=\"font-weight: bold\"> Trainable params: </span><span style=\"color: #00af00; text-decoration-color: #00af00\">200,140,326</span> (763.47 MB)\n","</pre>\n"]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["\u001b[1m Non-trainable params: \u001b[0m\u001b[38;5;34m80,128\u001b[0m (313.00 KB)\n"],"text/html":["<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\"><span style=\"font-weight: bold\"> Non-trainable params: </span><span style=\"color: #00af00; text-decoration-color: #00af00\">80,128</span> (313.00 KB)\n","</pre>\n"]},"metadata":{}}],"source":["class ConditionalDiffusionModel(keras.Model):\n","    def __init__(self, network, ema_network, timesteps, gdf_util, num_classes, ema=0.999):\n","        super().__init__()\n","        self.network = network\n","        self.ema_network = ema_network\n","        self.timesteps = timesteps\n","        self.gdf_util = gdf_util\n","        self.num_classes = num_classes\n","        self.ema = ema\n","\n","    def call(self, inputs, training=False):\n","        # Ensure the input is a tuple of the correct length\n","        if isinstance(inputs, tuple) and len(inputs) == 2:\n","            image_pre, image_post, image_topo, mask = inputs[0]  # Get images from first element of the tuple\n","            labels = inputs[1]  # Get labels from second element of the tuple\n","        else:\n","            raise ValueError(\"Input to the model should be a tuple with two elements: (images, labels)\")\n","    def train_step(self, data):\n","        ((image_pre, image_post, image_topo, mask), labels)  = data  # Unpack data\n","        images = tf.concat([tf.cast(image_pre, tf.float32),\n","                    tf.cast(image_post, tf.float32),\n","                    tf.cast(image_topo, tf.float32),\n","                    tf.cast(mask, tf.float32)], axis=-1)\n","\n","        batch_size = tf.shape(images)[0]\n","\n","        # 2. Sample timesteps uniformly\n","        t = tf.random.uniform(\n","            minval=0, maxval=self.timesteps, shape=(batch_size,), dtype=tf.int64\n","        )\n","\n","        with tf.GradientTape() as tape:\n","            # 3. Sample random noise to be added to the images in the batch\n","            noise = tf.random.normal(shape=tf.shape(images), dtype=images.dtype)\n","\n","            # 4. Diffuse the images with noise\n","            images_t = self.gdf_util.q_sample(images, t, noise)\n","\n","            # 5. Pass the diffused images and time steps to the network\n","            pred_noise = self.network([images_t, t, labels], training=True)\n","\n","            # 6. Calculate the loss\n","            loss = self.loss(noise, pred_noise)\n","\n","        # 7. Get the gradients\n","        gradients = tape.gradient(loss, self.network.trainable_weights)\n","\n","        # 8. Update the weights of the network\n","        self.optimizer.apply_gradients(zip(gradients, self.network.trainable_weights))\n","\n","        # 9. Updates the weight values for the network with EMA weights\n","        for weight, ema_weight in zip(self.network.weights, self.ema_network.weights):\n","            ema_weight.assign(self.ema * ema_weight + (1 - self.ema) * weight)\n","\n","        # 10. Return loss values\n","        return {\"loss\": loss}\n","\n","    def generate_images(self, num_images, class_labels, ddim_steps=None, ddim_eta=0.0):\n","        \"\"\"Modified generation for DDIM sampling\"\"\"\n","        # Use all steps if not specified\n","        if ddim_steps is None:\n","            ddim_steps = self.timesteps\n","\n","        # Create sampling schedule\n","        step_indices = np.linspace(0, self.timesteps-1, ddim_steps, dtype=int)\n","        timesteps = reversed(step_indices)\n","\n","        # Initial noise\n","        samples = tf.random.normal(\n","            shape=(num_images, img_size, img_size, img_channels),\n","            dtype=tf.float32\n","        )\n","\n","        for t in timesteps:\n","            tt = tf.cast(tf.fill(num_images, t), dtype=tf.int64)\n","            pred_noise = self.ema_network.predict(\n","                [samples, tt, class_labels], verbose=0, batch_size=num_images\n","            )\n","            samples = self.gdf_util.p_sample(\n","                pred_noise,\n","                samples,\n","                tt,\n","                clip_denoised=True,\n","                ddim_eta=ddim_eta\n","            )\n","        return samples\n","\n","    def fetch_one_image_per_class(self, dataset, num_classes=7):\n","        # Initialize a dictionary to store the first image of each class\n","        class_images = {i: {'pre': None, 'post': None, 'topo': None, 'mask': None} for i in range(num_classes)}\n","\n","        # Iterate over the entire dataset\n","        for image_data, labels in dataset:\n","            real_pre, real_post, real_topo, real_mask = image_data  # Unpack the image data\n","            # Iterate over the batch\n","            for i in range(real_pre.shape[0]):\n","                # Get the class label for the current image\n","                class_label = labels[i].numpy()  # Assuming labels are integers\n","\n","                # Check if we have already fetched an image for this class\n","                if class_images[class_label]['pre'] is None:\n","                    # If not, store the images for this class\n","                    class_images[class_label]['pre'] = real_pre[i].numpy()\n","                    class_images[class_label]['post'] = real_post[i].numpy()\n","                    class_images[class_label]['topo'] = real_topo[i].numpy()\n","                    class_images[class_label]['mask'] = real_mask[i].numpy()\n","\n","                # Once we have one image per class, we can stop (early exit)\n","                if all(class_images[i]['pre'] is not None for i in range(num_classes)):\n","                    return class_images\n","\n","        # If the loop completes without finding one image per class, return the images found\n","        return class_images\n","\n","    def plot_images(self, dataset, num_classes=7, num_samples=3, epoch=None, logs=None, interval=5):\n","        if epoch is None or (epoch + 1) % interval == 0:\n","            # Fetch one image per class from the entire dataset\n","            class_images = self.fetch_one_image_per_class(dataset)\n","\n","            # Create a figure with 28 rows (7 classes * 4 subplots) and 4 columns\n","            fig, axes = plt.subplots(28, 4, figsize=(8, 12 * 4))\n","\n","            # Iterate over each class\n","            for class_idx in range(num_classes):\n","                # Fetch the real images for the current class\n","                class_real_pre = class_images[class_idx]['pre']\n","                class_real_post = class_images[class_idx]['post']\n","                class_real_topo = class_images[class_idx]['topo']\n","                class_real_mask = class_images[class_idx]['mask']\n","\n","                # Generate random noise and labels for the current class\n","                class_labels = tf.constant([class_idx] * num_samples, dtype=tf.int32)\n","                class_labels = tf.reshape(class_labels, (-1, 1))  # Reshape to (num_samples, 1)\n","\n","                # Generate images\n","                generated_samples = self.generate_images(num_images=num_samples, class_labels=class_labels, ddim_steps=50)\n","\n","                pre_channels = 6\n","                post_channels = 6\n","                topo_channels = 6\n","                mask_channels = 1\n","\n","                gen_pre = generated_samples[:, :, :, :pre_channels]\n","                gen_post = generated_samples[:, :, :, pre_channels:pre_channels+post_channels]\n","                gen_topo = generated_samples[:, :, :, pre_channels+post_channels:pre_channels+post_channels+topo_channels]\n","                gen_mask = generated_samples[:, :, :, pre_channels+post_channels+topo_channels:]\n","\n","                # Plot real and generated images for the current class\n","                # Image type: Pre-event\n","                axes[class_idx * 4, 0].imshow((class_real_pre[:, :, :3] + 1) / 2)  # Ensure scaling\n","                axes[class_idx * 4, 0].axis(\"off\")\n","                axes[class_idx * 4, 0].set_title(f\"Class {class_idx} - Real Pre\", fontsize=10)\n","                for sample_idx in range(num_samples):\n","                    axes[class_idx * 4, sample_idx + 1].imshow((gen_pre[sample_idx, :, :, :3] + 1) / 2)\n","                    axes[class_idx * 4, sample_idx + 1].axis(\"off\")\n","                    axes[class_idx * 4, sample_idx + 1].set_title(f\"Sample {sample_idx + 1}\", fontsize=8)\n","\n","                # Image type: Post-event\n","                axes[class_idx * 4 + 1, 0].imshow((class_real_post[:, :, :3] + 1) / 2)  # Ensure scaling\n","                axes[class_idx * 4 + 1, 0].axis(\"off\")\n","                axes[class_idx * 4 + 1, 0].set_title(f\"Class {class_idx} - Real Post\", fontsize=10)\n","                for sample_idx in range(num_samples):\n","                    axes[class_idx * 4 + 1, sample_idx + 1].imshow((gen_post[sample_idx, :, :, :3] + 1) / 2)\n","                    axes[class_idx * 4 + 1, sample_idx + 1].axis(\"off\")\n","                    axes[class_idx * 4 + 1, sample_idx + 1].set_title(f\"Sample {sample_idx + 1}\", fontsize=8)\n","\n","                # Image type: Topography\n","                axes[class_idx * 4 + 2, 0].imshow((class_real_topo[:, :, :3] + 1) / 2)  # Ensure scaling\n","                axes[class_idx * 4 + 2, 0].axis(\"off\")\n","                axes[class_idx * 4 + 2, 0].set_title(f\"Class {class_idx} - Real Topo\", fontsize=10)\n","                for sample_idx in range(num_samples):\n","                    axes[class_idx * 4 + 2, sample_idx + 1].imshow((gen_topo[sample_idx, :, :, :3] + 1) / 2)\n","                    axes[class_idx * 4 + 2, sample_idx + 1].axis(\"off\")\n","                    axes[class_idx * 4 + 2, sample_idx + 1].set_title(f\"Sample {sample_idx + 1}\", fontsize=8)\n","\n","                # Image type: Mask\n","                axes[class_idx * 4 + 3, 0].imshow((class_real_mask[:, :, 0]+ 1) / 2, cmap='gray')\n","                axes[class_idx * 4 + 3, 0].axis(\"off\")\n","                axes[class_idx * 4 + 3, 0].set_title(f\"Class {class_idx} - Real Mask\", fontsize=10)\n","                for sample_idx in range(num_samples):\n","                    axes[class_idx * 4 + 3, sample_idx + 1].imshow((gen_mask[sample_idx, :, :, 0]+ 1) / 2, cmap='gray')\n","                    axes[class_idx * 4 + 3, sample_idx + 1].axis(\"off\")\n","                    axes[class_idx * 4 + 3, sample_idx + 1].set_title(f\"Sample {sample_idx + 1}\", fontsize=8)\n","\n","            plt.tight_layout()\n","            plt.show()\n","            plt.close()\n","\n","with strategy.scope():\n","    # Build the unet model\n","    network = build_model(\n","        img_size=img_size,\n","        img_channels=img_channels,\n","        widths=widths,\n","        has_attention=has_attention,\n","        has_chattention=has_chattention,\n","        n_class= 7,\n","        num_res_blocks=num_res_blocks,\n","        norm_groups=norm_groups,\n","        activation_fn=keras.activations.swish,\n","    )\n","\n","\n","    ema_network = build_model(\n","        img_size=img_size,\n","        img_channels=img_channels,\n","        widths=widths,\n","        has_attention=has_attention,\n","        has_chattention=has_chattention,\n","        n_class= 7,\n","        num_res_blocks=num_res_blocks,\n","        norm_groups=norm_groups,\n","        activation_fn=keras.activations.swish,\n","    )\n","    ema_network.set_weights(network.get_weights())  # Initially the weights are the same\n","\n","    # Get an instance of the Gaussian Diffusion utilities\n","    gdf_util = GaussianDiffusion(\n","        timesteps=total_timesteps,\n","        clip_min=clip_min,\n","        clip_max=clip_max\n","    )\n","\n","    # Get the model\n","    model = ConditionalDiffusionModel(\n","        network=network,\n","        ema_network=ema_network,\n","        gdf_util=gdf_util,\n","        timesteps=total_timesteps,\n","        num_classes=7\n","    )\n","    # Compile the model\n","    model.compile(\n","        loss=keras.losses.MeanSquaredError(),\n","        optimizer=keras.optimizers.AdamW(\n","                learning_rate=learning_rate, weight_decay=weight_decay))\n","model.network.summary()"]},{"cell_type":"code","execution_count":null,"metadata":{"collapsed":true,"id":"kKonP9i59k_E"},"outputs":[],"source":["# Plot the denoising model\n","plot_model(model.network, to_file='network_model.png', show_shapes=True, show_layer_names=True)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"x5IcjIpr4eud"},"outputs":[],"source":["class CustomModelCheckpoint(tf.keras.callbacks.Callback):\n","    def __init__(self, save_path, save_freq):\n","        super(CustomModelCheckpoint, self).__init__()\n","        self.save_path = save_path\n","        self.save_freq = save_freq  # Save every N epochs\n","\n","    def on_epoch_end(self, epoch, logs=None):\n","        if (epoch + 1) % self.save_freq == 0:  # Save every `save_freq` epochs\n","            save_filepath = self.save_path.format(epoch=epoch+1)\n","            self.model.save(save_filepath)\n","            print(f\"Model saved at epoch {epoch+1}: {save_filepath}\")\n","\n","# Define the custom checkpoint callback\n","checkpoint = CustomModelCheckpoint(\n","    save_path=\"/content/drive/MyDrive/landslide/Results/weights/DiffusionModel_{epoch:04d}.keras\",\n","    save_freq=40\n",")\n"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"zkD566-spuKh"},"outputs":[],"source":["plot_callback = keras.callbacks.LambdaCallback(\n","    on_epoch_end=lambda epoch, logs: model.plot_images(train